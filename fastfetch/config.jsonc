{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " -  ",
        "color": {
            "separator": "white"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[1;36m欢迎回来, \u001b[1;37mllylithe\u001b[1;36m"
        },
        "break",
        {
            "key": "OS          ",
            "type": "os"
        },
        {
            "key": "Packages    ",
            "type": "packages"
        },
        {
             "key": "WM          ",
             "type": "wm"
        },
        {
            "key": "Shell       ",
            "type": "shell"
        },
        {
            "key": "Terminal    ",
            "type": "terminal"
        },
        {
            "key": "Display     ",
            "type": "display"
        },
        {   "key": "Memory      ",
            "type": "memory"
        },
        {   "key": "CPU         ",
            "type": "CPU"
        },
        {
            "key": "Uptime      ",
            "type": "uptime"
        },
        {   "key": "Disk        ",
            "type": "disk"
        },
        "break",
        {
            "type": "colors",
        }
        
    ]
}
